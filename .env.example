# Copy to .env if you want to point the plugin at something other than the
# local defaults. Nothing here is needed for the tests or the examples.

# Local ollama (default provider). `ollama pull qwen3` first.
OLLAMA_HOST=http://localhost:11434
LLM_EVAL_MODEL=qwen3

# Any OpenAI-compatible server (llama.cpp, vLLM, LM Studio): --llm-provider openai
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_API_KEY=            # only for a hosted server, your own key

# Optional hosted judge: pip install "pytest-llm-evals[anthropic]" and
# --llm-judge-provider anthropic --llm-judge-model claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Run examples/ against real local models instead of the stand-ins.
# LLM_EVAL_EXAMPLES_LIVE=1
